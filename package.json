{
  "$schema": "https://raw.githubusercontent.com/vicinaehq/vicinae/refs/heads/main/extra/schemas/extension.json",
  "name": "mime-apps",
  "title": "Mime Apps",
  "description": "Browse and change default applications for file types (mimeapps.list) on Linux",
  "icon": "icon.png",
  "author": "brpaz",
  "license": "MIT",
  "commands": [
    {
      "icon": "icon.png",
      "name": "list",
      "subtitle": "Mime Apps",
      "title": "Mime Types",
      "description": "Browse every known mime type and set its default app",
      "mode": "view"
    }
  ],
  "preferences": [],
  "categories": [
    "System"
  ],
  "dependencies": {
    "@vicinae/api": "^0.28.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/react": "19.2.18",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "vici build",
    "dev": "vici develop",
    "lint": "biome check src/ && vici lint",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write ."
  }
}
